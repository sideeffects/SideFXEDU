--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/group1.spareparmdef"
Content-Type: text/plain

    parm {
        name    "groupname"
        baseparm
        label   "Group Name"
        export  all
    }
    parm {
        name    "grouptype"
        baseparm
        label   "Group Type"
        export  all
    }
    parm {
        name    "mergeop"
        baseparm
        label   "Initial Merge"
        export  none
    }
    groupsimple {
        name    "folder1"
        label   "Base Group"
        grouptag { "sidefx::switcher" "folder0" }

        parm {
            name    "groupbase"
            baseparm
            label   "Enable"
            export  none
        }
        parm {
            name    "basegroup"
            baseparm
            label   "Base Group"
            export  none
            bindselector ordered_prims_points_edges_verts "Group Geometry"
                "Select the points/primitives/edges/vertices to group and press Enter to complete."
                0 1 0xffffffff 0 grouptype 0
        }
        parm {
            name    "ordered"
            baseparm
            label   "Create Ordered"
            export  none
        }
        parm {
            name    "geotype"
            baseparm
            label   "Geometry Filter"
            export  none
        }
    }

    groupsimple {
        name    "switcher7"
        label   "Keep in Bounding Regions"
        grouptag { "sidefx::switcher" "switcher3" }

        parm {
            name    "groupbounding"
            baseparm
            label   "Enable"
            export  none
        }
        parm {
            name    "boundtype"
            baseparm
            label   "Bounding Type"
            export  none
        }
        parm {
            name    "size"
            baseparm
            label   "Size"
            export  none
        }
        parm {
            name    "t"
            baseparm
            label   "Center"
            export  none
        }
        parm {
            name    "initbounds"
            baseparm
            label   "Initialize to Input Bounds"
            export  none
        }
        parm {
            name    "includenotwhollycontained"
            baseparm
            label   "Include Partially Contained Entities"
            export  none
        }
        parm {
            name    "iso"
            baseparm
            label   "Iso Surface"
            export  none
        }
        parm {
            name    "invertvolume"
            baseparm
            label   "Invert"
            export  none
        }
    }

    groupsimple {
        name    "switcher8"
        label   "Keep by Normals"
        grouptag { "sidefx::switcher" "switcher4" }

        parm {
            name    "groupnormal"
            baseparm
            label   "Enable"
            export  none
        }
        parm {
            name    "camerapath"
            baseparm
            label   "Backface from"
            export  none
        }
        parm {
            name    "nonplanar"
            baseparm
            label   "Add Non-Planar Polygons"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "nonplanartol"
            baseparm
            label   "Non-Planar Polygons Tolerance"
            export  none
        }
        parm {
            name    "dir"
            baseparm
            label   "Direction"
            export  none
        }
        parm {
            name    "angle"
            baseparm
            label   "Spread Angle"
            export  none
        }
        parm {
            name    "oppositenormals"
            baseparm
            label   "Include Normals Matching Opposite Direction"
            export  none
        }
    }

    groupsimple {
        name    "switcher9"
        label   "Include by Edges"
        grouptag { "sidefx::switcher" "switcher5" }

        parm {
            name    "groupedges"
            baseparm
            label   "Enable"
            export  none
        }
        parm {
            name    "dominedgeangle"
            baseparm
            label   "Min Edge Angle"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "minedgeangle"
            baseparm
            label   "Min Edge Angle"
            export  none
        }
        parm {
            name    "domaxedgeangle"
            baseparm
            label   "Max Edge Angle"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "maxedgeangle"
            baseparm
            label   "Max Edge Angle"
            export  none
        }
        parm {
            name    "edgeanglebetweenedges"
            baseparm
            label   "Edge Angle Uses Angle Between Edges"
            export  none
        }
        parm {
            name    "dominedgelen"
            baseparm
            label   "Min Edge Length"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "minedgelen"
            baseparm
            label   "Min Edge Length"
            export  none
        }
        parm {
            name    "domaxedgelen"
            baseparm
            label   "Max Edge Length"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "maxedgelen"
            baseparm
            label   "Max Edge Length"
            export  none
        }
        parm {
            name    "dodepth"
            baseparm
            label   "Edge Depth"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "edgestep"
            baseparm
            label   "Edge Depth"
            export  none
        }
        parm {
            name    "edgeptgrp"
            baseparm
            label   "Point Group"
            export  none
        }
        parm {
            name    "unshared"
            baseparm
            label   "Unshared Edges"
            export  none
        }
        parm {
            name    "boundarygroups"
            baseparm
            label   "Create Boundary Groups"
            export  none
        }
    }

    groupsimple {
        name    "switcher10"
        label   "Keep by Random Chance"
        grouptag { "sidefx::switcher" "switcher6" }

        parm {
            name    "grouprandom"
            baseparm
            label   "Enable"
            export  none
        }
        parm {
            name    "globalseed"
            baseparm
            label   "Global Seed"
            export  none
        }
        parm {
            name    "useseedattrib"
            baseparm
            label   "Use Seed Attribute"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "seedattrib"
            baseparm
            label   "Seed Attribute"
            export  none
        }
        parm {
            name    "percent"
            baseparm
            label   "Percent"
            export  none
        }
    }

    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

