        baseparm
        label   "Vertical Alignment"
        export  none
    }
    parm {
        name    "use_descender"
        baseparm
        label   "Include Descender in Vertical Alignment"
        export  none
    }
    parm {
        name    "t"
        baseparm
        label   "Origin"
        export  none
    }
    parm {
        name    "r"
        baseparm
        label   "Rotate"
        export  none
    }
    parm {
        name    "s"
        baseparm
        label   "Scale"
        export  none
    }
    parm {
        name    "tracking"
        baseparm
        label   "Tracking"
        export  none
    }
    parm {
        name    "fontsize"
        baseparm
        label   "Font Size"
        export  all
    }
    parm {
        name    "oblique"
        baseparm
        label   "Oblique Angle"
        export  none
    }
    parm {
        name    "lod"
        baseparm
        label   "Level of Detail"
