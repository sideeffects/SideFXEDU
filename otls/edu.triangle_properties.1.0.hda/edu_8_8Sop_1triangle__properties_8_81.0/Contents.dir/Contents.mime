vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int ctype = chi(\"../constraint\");
vector2 pos = chu(\"pos\");
float l = 1;

if(ctype == 0){
    v@P = pos;
}
else if(ctype == 1){
    v@P = set(0, pos.y, 0);
}
else if(ctype == 2){
    l = length(pos);
    v@P = set(pos.x/l, pos.y/l, 0);
}



"	)
