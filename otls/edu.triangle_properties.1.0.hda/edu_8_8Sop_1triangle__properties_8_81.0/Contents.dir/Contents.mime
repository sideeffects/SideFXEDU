    }
    parm {
        name    "autokern"
        baseparm
        label   "Automatic Kerning"
        export  none
    }
    parm {
        name    "hole"
        baseparm
        label   "Hole Faces"
        export  none
    }
    parm {
        name    "addattrib"
        baseparm
        label   "Add Text Attributes"
        export  none
    }
    parm {
        name    "spare_input0"
        label   "Spare Input 0"
        type    oppath
        default { "" }
        help    "Refer to this in expressions as -1, such as: npoints(-1)"
        parmtag { "cook_dependent" "1" }
        parmtag { "opfilter" "!!SOP!!" }
        parmtag { "oprelative" "." }
    }

