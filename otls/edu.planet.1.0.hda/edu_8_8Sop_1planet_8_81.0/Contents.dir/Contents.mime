f@distance_from_central_body = chf(\"distance_from_central_body\");
f@perihelion = chf(\"perihelion\");
f@aphelion = chf(\"aphelion\");
f@orbital_period = chf(\"orbital_period\");
f@orbital_velocity = chf(\"orbital_velocity\");
f@orbital_inclination = chf(\"orbital_inclination\");
f@orbital_eccentricity = chf(\"orbital_eccentricity\");
f@obliquity_to_orbit = chf(\"obliquity_to_orbit\");
f@mean_temperature = chf(\"mean_temperature\");
f@surface_pressure = chf(\"surface_pressure\");
i@number_of_moons = chi(\"number_of_moons\");
i@ring_system = chi(\"ring_system\");
i@global_magnetic_field = chi(\"global_magnetic_field\");"	)
exportlist	[ 0	locks=0 ]	(	*	)
