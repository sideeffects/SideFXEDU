      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../north/trackingy\") }
    }
    channel trackingx {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../north/trackingx\") }
    }
    channel sy {
      lefttype = extend
      righttype = extend
