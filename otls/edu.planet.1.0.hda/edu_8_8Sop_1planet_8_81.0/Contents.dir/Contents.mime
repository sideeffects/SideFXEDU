snippet	[ 0	locks=0 ]	(	"//
// source: https://nssdc.gsfc.nasa.gov/planetary/factsheet/planetfact_notes.html#orbo 
//

f@mass = chf(\"mass\");
f@diameter = chf(\"diameter\");
f@density = chf(\"density\");
f@gravity = chf(\"gravity\");
f@escape_velocity = chf(\"escape_velocity\");
f@rotation_period = chf(\"rotation_period\");
