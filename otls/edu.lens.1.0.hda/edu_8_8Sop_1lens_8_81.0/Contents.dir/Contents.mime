--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/setup_attributes2.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int lens_shape = chi(\"lens_shape\");
int curvature = 0;
float D = ch(\"lens_diameter\");
float index = ch(\"refractive_index\");
float r = ch(\"curvature_radius\"); // Radius of curvature in mm
float lens_thickness = ch(\"lens_thickness\");
vector center = {0, 0, 0};
float d=0;
float sag=0; // sagitta cf. http://static.laramyk.com/wp-content/uploads/2010/05/methods.pdf

// define if lens is convex or concave
if((lens_shape == 0) || (lens_shape == 1))
    curvature = -1;
else
    curvature = 1;

// compute center of curvature distance on z axis
d = sqrt( pow(r, 2.0) - pow(0.5*D, 2.0) );
center = set(0, 0, curvature*d);

// compute sagitta
sag = r-d;

// assign values to attributes 
i@curvature = curvature;
v@center = center;
f@index = index;
f@radius = r;
f@flength = r/(index-1); // 1/f = (index-1) * (1/r1 + 1/r2);
f@sagitta = sag;
f@lens_thickness = lens_thickness;

if(curvature > 0){
    if(lens_thickness > sag)
        f@edge_thickness = lens_thickness;
    else 
        f@edge_thickness = 1.01*sag; // we add a little extra room for rays at the center otherwise they stop and do not reach the other side of the lens.
}
else{
    if(lens_thickness > sag)
        f@edge_thickness = lens_thickness-sag;
    else 
        f@edge_thickness = 0;
}
"	)
